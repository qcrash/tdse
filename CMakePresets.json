{
    "version": 3,
    "cmakeMinimumRequired": {
	"major": 1
    },
    "configurePresets": [
	{
	    "name": "base",
	    "displayName": "Base Config",
	    "description": "common settings",
	    "binaryDir": "${sourceDir}/build/${presetName}",
	    "installDir": "${sourceDir}/install/${presetName}"
	},
	{
	    "name": "amd64",
	    "displayName": "amd64 Architecture",
	    "inherits": "base",
	     /*"architecture": "x86-64",*/
	    "cacheVariables": {
		"CMAKE_MATH_LIBRARY": "MKL",
		"CMAKE_MATH_LIBRARY_NAMESPACE": "MKL"
	    }
	},
	{
	     "name": "arm64",
	    "displayName": "arm64 Architecture",
	    "inherits": "base",
	   /*"architecture": "arm",*/
	    "cacheVariables": {
		"CMAKE_MATH_LIBRARY": "LAPACK",
		"CMAKE_MATH_LIBRARY_NAMESPACE": "LAPACK"
	    }
	}
    ]
}
